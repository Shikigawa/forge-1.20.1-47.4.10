# ==========================================
# БАЗОВЫЕ НАСТРОЙКИ И ВЕРСИИ
# ==========================================
SERVER_NAME=DivineRPG
EULA=TRUE
UID=1000
GID=1000
TZ=Europe/Moscow

TYPE=FORGE
VERSION=1.20.1
# ИСПРАВЛЕНИЕ: Версия исправлена на 47.4.13, чтобы совпадать с ссылкой на установщик ниже
FORGE_VERSION=47.4.13 
FORGE_INSTALLER_URL=https://github.com/Shikigawa/forge-1.20.1-47.4.10/raw/refs/heads/main/Forge-ver/forge-1.20.1-47.4.13-installer.jar
FORGE_MAVEN_REPO_URL=https://maven.minecraftforge.net

# ==========================================
# ИГРОВЫЕ НАСТРОЙКИ
# ==========================================
OPS_PLAYERS=Zander
ONLINE_MODE=false
DIFFICULTY=normal
# ИСПРАВЛЕНИЕ: Убран дубль переменной MODE. Оставлен survival, так как для RPG-сборки creative не подходит.
MODE=survival 
HARDCORE=false
PVP=true
ALLOW_NETHER=true
GENERATE_STRUCTURES=true
SPAWN_ANIMALS=true
SPAWN_MONSTERS=true
SPAWN_NPCS=true
# ДОБАВЛЕНО: В модпаках (особенно RPG с магией и полетами) ванильный античит часто кикает игроков.
ALLOW_FLIGHT=true 

# ==========================================
# ПРОИЗВОДИТЕЛЬНОСТЬ И МИР (Оптимизация под Xeon X5670)
# ==========================================
MAX_WORLD_SIZE=4000
VIEW_DISTANCE=10
# ИСПРАВЛЕНИЕ: Снижено с 10 до 8. 10 чанков симуляции для тяжелой RPG-сборки убьют ваше слабое одно ядро.
SIMULATION_DISTANCE=8 
# ИСПРАВЛЕНИЕ: Значение должно быть в нижнем регистре (false), а не False.
SYNC_CHUNK_WRITES=false 

# ==========================================
# ПАМЯТЬ И JAVA (КРИТИЧЕСКИ ВАЖНО!)
# ==========================================
# ИСПРАВЛЕНИЕ: Снижено с 24G до 10G. 
# DivineRPG — тяжелая сборка, 10G ей хватит с головой. 
# Если выделить 24G, сборщик мусора Java будет вызывать фризы по 2-3 секунды.
MEMORY=10G

# ДОБАВЛЕНО: Флаги JVM (Aikar's Flags), адаптированные под 10G. 
# Без них старый Xeon будет "захлебываться" при очистке памяти.
JVM_OPTS=-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1

# ==========================================
# УПРАВЛЕНИЕ (RCON)
# ==========================================
ENABLE_RCON=true
RCON_PORT=25575
RCON_PASSWORD=ChangeThisPassword123
